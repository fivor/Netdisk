# 网盘转存站环境变量模板
# 复制为 .env 并填入真实值；.env 含敏感凭据，不要提交到任何仓库

# ---- 鉴权 ----
# 全站访问口令（X-Auth-Token）：非空时 /api/* 全部要求口令；上线前建议启用
APP_PASSWORD=
# 管理员口令：解锁全部转存记录 + 网盘就绪状态；为空时仅限本机访问可当管理员
ADMIN_PASSWORD=

# ---- 通知与去重 ----
# 完成通知（可选）：Bark 推送前缀（如 https://api.day.app/<你的KEY>）
# 非空时任务成功落终态会推送到手机；留空则只保留浏览器桌面通知
BARK_URL=
# 同链接短时间去重窗口（秒）：窗口内重复提交相同 源+目标+分享文本 会复用旧任务，默认 600
DEDUP_SECONDS=600

# ---- OpenList ----
# OpenList 管理 token（登录后台后：设置-其他-令牌 中生成）
# 跨平台转存（如 夸克→百度）必需；仅同平台直转可留空
OPENLIST_TOKEN=

# 百度网盘「在线 API」续期用的 refresh_token（OpenList 百度驱动 use_online_api=true 时用）
# 填了才能自动续期访问令牌；留空时百度挂载会在令牌过期后失效
OPENLIST_BAIDU_REFRESH_TOKEN=

# 各平台在 OpenList 中的挂载目录（需与 OpenList 后台实际挂载名一致）
OPENLIST_MOUNT_BAIDU=/baidu
OPENLIST_MOUNT_QUARK=/quark
OPENLIST_MOUNT_ALI=/ali
OPENLIST_MOUNT_UC=/uc
OPENLIST_MOUNT_LOCAL=/local

# ---- 跨平台中转保护（大文件务必关注）----
# OpenList 跨盘 copy 会「先下载到本机临时文件、再上传目标」，因此：
# 停滞检测：字节连续 N 分钟零增长才判卡死（替代固定超时）
# 停滞检测：下载与上传**两路**都连续这么多分钟无进展才判卡死（上传大文件期间
# 下载早已停止，旧实现只看下载量会误判并取消任务，2026-09-17 事故）
RELAY_STALL_MIN=15
# 单个中转任务硬上限（小时）
RELAY_MAX_HOURS=24
# 空间校验安全系数：最大单文件 × 该值 ≤ 中转盘剩余空间，否则任务直接拒绝
RELAY_DISK_SAFETY=1.2
# 启动回收：只取消「两次采样 progress 完全没变化」的僵尸复制任务；
# 重启时若 OpenList 仍在正常上传，一律保留（取消会把已下载的临时数据废掉）
RELAY_REAP_ON_BOOT=1
# 强制清理开关：置 1 时忽略「仍在推进」判断，直接取消中转目录下所有未完成任务
# （明知会毁掉在途上传时才用）
RELAY_REAP_FORCE=0
# 注：OpenList 复制并发在 data/openlist/config.json 的 tasks.copy.workers（当前 3）
# 注：百度驱动上传参数在 OpenList 后台 → 存储 → /baidu：
#     upload_thread 必须为 1（=3 时并发分片会报 error_code 31299 Invalid param part_id，
#     alist#5628 已知问题）；建议开 low_bandwith_upload_mode，会员可加大
#     custom_upload_part_size（如 32MB）以减少分片数（4MB 分片 + 2048 分片上限 ≈ 8GB 天花板）

# ---- 本机高速下载 ----
# 缓存根目录（容器内路径；宿主机为 ./data/downloads，与 OpenList 共享）
LOCAL_DIR=/data/downloads
# 缓存 TTL（天，最近下载超过该天数自动清理）与容量软上限（GB，超限按最久未下载淘汰）
CACHE_TTL_DAYS=7
CACHE_MAX_GB=300
# OpenList 百度驱动挂载用的刷新令牌（api.oplist.org/baiduyun/renewapi 在线续期模式）
# OPENLIST_BAIDU_REFRESH_TOKEN=

# ---- 百度网盘（Cookie 方案，需要 BDUSS 与 STOKEN）----
# 浏览器登录 pan.baidu.com 后从 DevTools 复制整串 Cookie
BAIDU_COOKIE=

# ---- 夸克网盘（Cookie 方案）----
# 浏览器登录 pan.quark.cn 后从 DevTools 复制整串 Cookie
QUARK_COOKIE=

# ---- UC 网盘（Cookie 方案，与夸克同构接口）----
# 浏览器登录 drive.uc.cn 后从 DevTools 复制整串 Cookie（需含 __pus/__puus）
UC_COOKIE=

# ---- 阿里云盘（OpenList 在线续期通道）----
# 注意：阿里已于 2025-07 暂停个人开发者申请，改用 OpenList 生态通行方案：
# 1. 打开 https://api.oplist.org/ → 选"阿里云盘(OAuth2)扫码登录"
# 2. 勾选"使用 OpenList 提供的参数" → 扫码授权
# 3. 复制"刷新令牌(Refresh Token)"填到下面
# refresh_token 会自动轮换，转存站持久化到 data/app/ali_token_state.json，无需手动维护
ALI_REFRESH_TOKEN=
# 企业应用凭证（个人用户留空；填写后自动切换为官方直连刷新）
ALI_CLIENT_ID=
ALI_CLIENT_SECRET=

# ---- Linux.do Connect（OAuth2 登录，可选；两个值都填了才启用）----
# 1) 用 Linux.do 账号访问 https://connect.linux.do/dash/sso/new 申请接入
# 2) 回调地址填: https://your-domain.example/api/auth/linuxdo/callback
# 3) 审批后把 Client ID / Client Secret 填到下面，然后 docker compose up -d
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 信任等级门槛（0-4，默认 0 不限制；建议 1 挡新注册小号）
LINUXDO_MIN_TRUST_LEVEL=0
# 回调地址留空则按访问域名自动推导；固定域名时建议显式配置：
# LINUXDO_REDIRECT_URI=https://your-domain.example/api/auth/linuxdo/callback
